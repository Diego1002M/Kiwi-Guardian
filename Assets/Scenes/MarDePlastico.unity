  m_Script: {fileID: 11500000, guid: eda624dbc44c595418b4bf6710d46ada, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CompanionNPC
  npcName: "Ping\xFCino (Gu\xEDa del Mar de Pl\xE1stico)"
  dialogueText: "Kiwi: \xABEste lugar antes estaba lleno de vida... \xBFqu\xE9 le pas\xF3?\xBB\n\nPing\xFCino: \xABLa contaminaci\xF3n de pl\xE1stico corrompi\xF3 este oc\xE9ano y a su Esp\xEDritu guardi\xE1n. \xA1Usa tus dagas [J] o p\xEDsalas para vencer a las Moscas de basura, y presiona [W] dos veces en el aire para el \xA1Sobre-Salto! Lleva la \xDAltima Semilla de tu mochila hasta el Altar para salvar el mar.\xBB"
  talkDistance: 3.5
